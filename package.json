{
  "name": "colosseum-cli",
  "version": "0.2.0",
  "description": "A terminal colosseum where two AI agents fight to the death by killing each other's process.",
  "type": "module",
  "bin": {
    "colosseum": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.tsx",
    "start": "node dist/cli.js",
    "test": "node --import tsx --test test/*.test.ts test/*.test.tsx",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "tui",
    "ai",
    "agents",
    "colosseum",
    "ink"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "ink-testing-library": "4.0.0",
    "sharp": "0.35.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.58",
    "@ai-sdk/openai": "4.0.71",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.107",
    "ink": "5.2.1",
    "react": "18.3.1",
    "zod": "3.25.76"
  }
}
