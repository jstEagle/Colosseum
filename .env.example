# Colosseum reads whichever key matches the provider you pick.
#
# You may not need any of these: the Claude and Codex subscription providers
# use their own CLI login, and Ollama needs nothing.

# OpenRouter is the default key-based provider — one key reaches every model:
OPENROUTER_API_KEY=sk-or-...

# Optional: use native providers directly instead of OpenRouter.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional: anything that speaks the OpenAI wire format (Gemini's compatible
# endpoint, Groq, Together, vLLM, your own gateway).
# COMPATIBLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# COMPATIBLE_API_KEY=...

# Optional: the image the sealed (Docker) sandbox fights in.
# COLOSSEUM_IMAGE=alpine:3.20
